{
  "name": "sadeem",
  "version": "2.0.0",
  "description": "سديم - نظام إدارة المصانع المتكامل - الإصدار المتطور",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:win32": "electron-builder --win --ia32 --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "dist": "electron-builder --win --x64 --ia32 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Sadeem Team - محمود حازم & مصطفى رينو",
  "license": "Proprietary",
  "devDependencies": {
    "electron": "27.0.0",
    "electron-builder": "24.6.4"
  },
  "dependencies": {
    "better-sqlite3": "9.2.2",
    "electron-store": "8.1.0",
    "node-machine-id": "1.1.12",
    "crypto-js": "4.2.0",
    "pdfkit": "0.14.0",
    "xlsx": "0.18.5",
    "fs-extra": "11.1.1",
    "uuid": "9.0.1",
    "mammoth": "1.6.0",
    "docx": "8.2.2"
  },
  "build": {
    "appId": "com.sadeem.factory.pro",
    "productName": "سديم برو",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "src/assets"
    },
    "win": {
      "target": "nsis",
      "icon": "node_modules/electron/dist/electron.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/logo.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سديم",
      "installerIcon": "node_modules/electron/dist/electron.ico",
      "uninstallerIcon": "node_modules/electron/dist/electron.ico",
      "perMachine": true
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/assets/",
        "to": "assets/"
      }
    ]
  }
}
